{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2025",
    "moduleResolution": "nodenext",
    "rootDir": "./api",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {}
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules"]
}
